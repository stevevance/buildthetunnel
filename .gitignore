# Large rendered video artifacts (exceed GitHub's file-size limits; the live
# HTML viewer reproduces the flythrough). Track with Git LFS if you need them.
*.mov
*.mp4

# macOS
.DS_Store

# Privately shared source files (Scott/Star:Line) — not for publication
private/

# Assembled r5r routing networks (derived from analysis/r5r_network_inputs via assemble_networks.sh)
analysis/networks/

# Full CTA GTFS download (hundreds of MB; re-download from transitchicago.com when needed)
analysis/cta_live_gtfs/

# Node deps + wrangler state for the Cloudflare Worker (source is tracked, deps are not)
worker/node_modules/
worker/.wrangler/

# Derived travel-time cache for the venue catchment map (regenerated by the script)
analysis/results/.catchment_ttm_cache.rds

# Local Claude Code plans/session files
.claude/

# Rail-access gap and infill-station analysis outputs. All derived — regenerate with
# analysis/no_rail_trip_blocks.py, infill_station_candidates.py, connectivity_stations.py,
# jobs_access_planner_data.py and the accompanying map scripts. Two of them (the
# block-level GeoJSON and CSV) run to 69 MB together, which does not belong in history.
analysis/results/no_rail_trip_*
analysis/results/unserved_blocks_corridor.csv
analysis/results/infill_*
analysis/results/connectivity_*
analysis/results/conn_crossstreets.csv
analysis/results/site_crossstreets.csv
analysis/results/station_jobs_access.csv
analysis/results/station_commute_flows.csv
analysis/results/nrt_web.png
analysis/results/*_web_*.png

# Launch-video projects (/brag): keep the compositions, scripts and stills, but
# not the audio. Rendered video is already covered by *.mp4 / *.mov above.
brag-output/**/*.mp3
brag-output/**/*.ogg
brag-output/**/*.wav
brag-output/**/*.m4a
# render logs (tools/droplet-render.sh writes one beside each video)
brag-output/**/*.log
# HyperFrames render caches and Python bytecode in the launch-video projects
brag-output/**/.hyperframes/
brag-output/**/__pycache__/

# Subscriber newsletters: drafts, send log and sent copies stay local
newsletter/
.linode-token

# the cab ride page's videos live on R2 (cabride/media holds local copies for testing)
cabride/media/

# reference images for the modeled buildings: openly licensed ones are committed with their SOURCES.md; the rest stay local
brag-output/*/refs/*/private/
# the 360 views' images live on R2 too (tools/upload-panos.sh); only each view's meta.json is in git
cabride/pano/*/base/
cabride/pano/*/tiles/
cabride/pano/*/cross.jpg

# the films' review renders (contact sheets and stills; copies go to the Desktop for review), generated model exports,
# downloaded source archives and tool caches stay local
brag-output/*/previews/
brag-output/*/exports/
brag-output/*/assets/*.zip
brag-output/*/tools/.cache/

# the trip planner's walking tiles (planner/tools/build-walk-tiles.mjs) live on R2: planner/tools/upload-walk-tiles.sh
planner/data/walk/
